<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" prefHeight="635.0" prefWidth="950.0" styleClass="jouer-background" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.timeline.controller.JouerController">
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="Partie">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#newGameAction" text="Nouvelle partie 1J" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="À propos">
                    <items>
                        <MenuItem mnemonicParsing="false" text="About" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <children>
            <ScrollPane fx:id="scrollPane" fitToHeight="true" hbarPolicy="NEVER" pannable="true" vbarPolicy="NEVER">
              <content>
                <AnchorPane fx:id="anchorPane" style="-fx-background-color: #00000000;">
                     <children>
                            <HBox fx:id="board" alignment="CENTER" prefWidth="950.0" />
                     </children>
                  </AnchorPane>
              </content>
            </ScrollPane>
            </children>
        </VBox>
    </center>

    <bottom>
        <BorderPane BorderPane.alignment="CENTER">
            <center>
                <HBox fx:id="playerHand" alignment="CENTER" prefHeight="150.0" prefWidth="900.0" style="-fx-background-color: transparent;" />
            </center>
         <bottom>
            <AnchorPane prefHeight="45.0" prefWidth="950.0" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="titreDeck" alignment="CENTER" contentDisplay="CENTER" layoutX="175.0" layoutY="4.0" prefHeight="45.0" prefWidth="600.0" text="Titre du deck" textAlignment="CENTER" textFill="WHITE">
                     <font>
                        <Font size="30.0" />
                     </font>
                  </Label>
                  <Label layoutX="898.0" layoutY="18.0" text="0" textFill="WHITE">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
               </children>
            </AnchorPane>
         </bottom>
        </BorderPane>
    </bottom>
</BorderPane>
