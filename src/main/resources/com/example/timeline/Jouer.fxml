<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            prefHeight="500.0" prefWidth="900.0"
            styleClass="jouer-background"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.timeline.controller.JouerController">
   <center>
      <VBox alignment="CENTER">
         <children>
            <HBox fx:id="board" prefHeight="198.0" prefWidth="900.0" />
            <Label fx:id="titreDeck" text="TITRE" />
            </children>
      </VBox>
   </center>
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" onAction="#newGameAction" text="Partie">
            <items>
              <MenuItem mnemonicParsing="false" text="Nouvelle partie 1J" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="A propos">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <bottom>
      <BorderPane BorderPane.alignment="CENTER">
         <center>
            <HBox fx:id="playerHand" alignment="CENTER" prefHeight="150.0" prefWidth="900.0" style="-fx-background-color: #222f;">
               <children>
                  </children>
            </HBox>
         </center>
      </BorderPane>
   </bottom>
</BorderPane>
