<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.timeline.controller.CollectionController">
   <children>
      <Label layoutX="14.0" layoutY="14.0" text="Decks">
         <font>
            <Font size="48.0" />
         </font>
      </Label>
      <Button layoutX="14.0" layoutY="367.0" mnemonicParsing="false" onAction="#onClickRetour" prefWidth="96.0" text="Retour" />
      <VBox layoutX="13.0" layoutY="78.0" spacing="5.0">
         <children>
            <Label text="Decks :" />
            <HBox spacing="5.0">
               <children>
                  <ComboBox fx:id="decks" prefWidth="301.0" promptText="Choisir un deck" />
               </children>
            </HBox>
            <HBox spacing="5.0">
               <children>
                  <TextField fx:id="deckField" prefWidth="301.0" promptText="Nom du deck" />
               </children>
            </HBox>
            <HBox spacing="5.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#editDeck" prefWidth="97.0" text="Modifier" />
                  <Button mnemonicParsing="false" onAction="#deleteDeck" prefWidth="97.0" text="Supprimer" />
                  <Button mnemonicParsing="false" onAction="#addDeck" prefWidth="97.0" text="Ajouter" />
               </children>
            </HBox>
            <Label text="Cartes :">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>
            <HBox spacing="5.0">
               <children>
                  <ComboBox fx:id="cards" prefWidth="301.0" promptText="Choisir une carte" />
               </children>
            </HBox>
            <HBox spacing="5.0">
               <children>
                  <TextField fx:id="cardTitleField" prefWidth="235.0" promptText="Titre" />
                  <TextField fx:id="cardDateField" prefWidth="235.0" promptText="Date" />
               </children>
            </HBox>
            <HBox spacing="5.0">
               <children>
                  <TextField fx:id="cardImageField" prefWidth="235.0" promptText="Image" />
                  <TextField fx:id="cardDescriptionField" prefWidth="235.0" promptText="Description" />
               </children>
            </HBox>
            <HBox spacing="5.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#editCard" prefWidth="97.0" text="Modifier" />
                  <Button mnemonicParsing="false" onAction="#deleteCard" prefWidth="97.0" text="Supprimer" />
                  <Button mnemonicParsing="false" onAction="#addCard" prefWidth="97.0" text="Ajouter" />
               </children>
            </HBox>
         </children>
      </VBox>
      <Button layoutX="488.0" layoutY="367.0" mnemonicParsing="false" onAction="#save" prefWidth="96.0" text="Sauvegarder" />
   </children>
</AnchorPane>
